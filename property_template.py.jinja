import json
import random

PROPERTY = "{{ property_name }}"
REPETITIONS = {{ repetitions }}
SEED = {{ seed }}
MIN_VALUE = {{ min_value }}
MAX_VALUE = {{ max_value }}

# Numeric type selection
{% if numeric_type == "PythonFloat32" %}
import numpy as np
NUMBER_TYPE = np.float32
TYPE_LABEL = "float32"
{% elif numeric_type == "PythonFloat64" %}
NUMBER_TYPE = float
TYPE_LABEL = "float64"
{% endif %}

# Random generator selection
{% if random_generator == "PythonRandom" %}
rng = random.Random(SEED)
{% elif random_generator == "PythonNumPyRandom" %}
import numpy as np
rng = np.random.default_rng(SEED)
{% endif %}


def check_property():
    equal_count = 0

    for _ in range(REPETITIONS):
        x = NUMBER_TYPE(rng.uniform(MIN_VALUE, MAX_VALUE))
        y = NUMBER_TYPE(rng.uniform(MIN_VALUE, MAX_VALUE))
        z = NUMBER_TYPE(rng.uniform(MIN_VALUE, MAX_VALUE))

        if {{ lhs }} == {{ rhs }}:
            equal_count += 1

    different_count = REPETITIONS - equal_count

    return {
        "property": PROPERTY,
        "type": TYPE_LABEL,
        "random_generator": "{{ random_generator }}",
        "repetitions": REPETITIONS,
        "seed": SEED,
        "min_value": MIN_VALUE,
        "max_value": MAX_VALUE,
        "equal_count": equal_count,
        "different_count": different_count,
        "percentage": 100.0 * equal_count / REPETITIONS,
    }


if __name__ == "__main__":
    print(json.dumps(check_property()))